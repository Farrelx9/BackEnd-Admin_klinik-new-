// Prisma schema for Klinik Senyum — dental clinic backend.
// Run `npx prisma generate` after editing, and `npx prisma migrate dev`
// to apply changes to the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOKTER
}

enum Gender {
  L
  P
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  QRIS
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(DOKTER) // <-- Diubah dari STAF menjadi DOKTER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]   @relation("DokterAppointments")
  medicalRecords MedicalRecord[] @relation("DokterRecords")

  @@map("users")
}

model Patient {
  id        String    @id @default(cuid())
  name      String
  nik       String?   @unique
  phone     String?
  email     String?
  address   String?
  birthDate DateTime?
  gender    Gender?
  bloodType String?
  allergies String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  payments       Payment[]

  @@map("patients")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointmentServices   AppointmentService[]
  medicalRecordServices MedicalRecordService[]

  @@map("services")
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  dokterId    String?
  dokter      User?             @relation("DokterAppointments", fields: [dokterId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  services      AppointmentService[]
  medicalRecord MedicalRecord?

  @@map("appointments")
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

model MedicalRecord {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  dokterId      String?
  dokter        User?        @relation("DokterRecords", fields: [dokterId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  complaint     String?
  diagnosis     String?
  treatment     String?
  notes         String?
  visitDate     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  services MedicalRecordService[]
  payment  Payment?

  @@map("medical_records")
}

model MedicalRecordService {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  toothNumber     String?
  priceAtTime     Decimal       @db.Decimal(12, 2)

  @@map("medical_record_services")
}

model Payment {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  medicalRecordId String?        @unique
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  amount          Decimal        @db.Decimal(12, 2)
  method          PaymentMethod  @default(CASH)
  status          PaymentStatus  @default(UNPAID)
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("payments")
}